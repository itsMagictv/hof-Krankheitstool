# --- Pflicht ---------------------------------------------------------------
# Passwort für den Admin-Bereich (/admin)
ADMIN_PASSWORD=bitte-aendern
# Zufälliger Schlüssel für Sessions, z. B. erzeugt mit: openssl rand -hex 32
SECRET_KEY=

# --- Optional --------------------------------------------------------------
COMPANY_NAME=Hof Dinkelberg
# Öffentliche Adresse (für den Link in der E-Mail)
PUBLIC_URL=https://krank.example.de
# true setzen, sobald das Tool nur noch per HTTPS erreichbar ist
SECURE_COOKIES=false
# Tage nach dem Bis-Datum, nach denen Meldungen gelöscht werden
RETENTION_DAYS=30
# IP bzw. Netz des Reverse Proxys, dessen X-Forwarded-For-Header vertraut wird.
# Nur dann sieht das Rate-Limit die echte IP der Mitarbeiter. NIEMALS "*" setzen,
# wenn Port 8000 direkt erreichbar ist – sonst kann jeder seine IP fälschen.
# Beispiele: 172.16.0.0/12 (Proxy im selben Docker-Netz), 10.0.0.5
FORWARDED_ALLOW_IPS=127.0.0.1

# --- E-Mail-Benachrichtigung (optional, leer lassen = aus) ------------------
# Die Mail enthält nur Name + Zeitraum, keine Art der AU und keine Bemerkung.
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Empfänger, mehrere durch Komma getrennt
SMTP_TO=
